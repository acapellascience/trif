{
  "name": "webmods",
  "version": "0.1.0",
  "description": "Customize any website with mods written by your coding agent: a Chrome extension, a native messaging helper and the `webmods` CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acapellascience/WebMods.git"
  },
  "homepage": "https://github.com/acapellascience/WebMods#readme",
  "bugs": {
    "url": "https://webmods.dev/report",
    "email": "reports@webmods.dev"
  },
  "type": "commonjs",
  "bin": {
    "webmods": "helper/cli.js"
  },
  "files": [
    "helper/",
    "extension/",
    "examples/",
    "docs/PROTOCOL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "chrome-extension",
    "userscripts",
    "coding-agent",
    "claude-code",
    "codex"
