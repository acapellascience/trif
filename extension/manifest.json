{
  "manifest_version": 3,
  "name": "WebMods",
  "version": "0.1.1",
  "description": "Customize any website with mods written by your coding agent.",
  "key": "",
  "minimum_chrome_version": "135",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "WebMods",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "userScripts",
    "storage",
    "tabs",
    "nativeMessaging",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
