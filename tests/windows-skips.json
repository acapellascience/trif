    "sockets": "about Unix sockets as files (named pipes: tests/windows.test.js)",
    "legacy": "about the move from ~/.webmods (before 0.2.0), which Windows never had",
    "safari": "Safari and launchd are macOS only",
    "release": "the build and release scripts are for the Mac (zip, the Keychain)"
