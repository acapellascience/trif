<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What Xcode's generated Info.plist can't say (GENERATE_INFOPLIST_FILE merges this in): the files the app opens
     from the share sheet, AirDrop and Files (Import.swift): a mod (.js), a zip of mods or a browser's export, a
     history export (.json). Copies come to the app (not opened in place), which reads and then removes them. -->
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>TRIF mod</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.netscape.javascript-source</string>
				<string>public.zip-archive</string>
				<string>public.json</string>
			</array>
		</dict>
	</array>
	<!-- (trif://open?url=<a site>: the address of a site's Home Screen icon, WebClip.swift; trif://add, a mod's code;
	     trif://pair, desktop TRIF's Connect a phone code, PhoneLinkView.swift) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.timsrobot.trif.open</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>trif</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.timsrobot.trif.pause</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Pause all mods</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypePause</string>
		</dict>
	</array>
	<!-- (a page asking for the camera or microphone, x.com's compose for a photo: without these iOS ends the app at
	     once. Tim's phone, 11-15 23:08, a TCC abort) -->
	<key>NSCameraUsageDescription</key>
	<string>To scan the code TRIF shows on your computer. Websites you visit can also ask to use the camera, for a photo or a video call.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>To hear what you'd like changed while you hold the microphone in TRIF. Websites you visit can also ask to use the microphone, for a voice or video call.</string>
	<!-- (quick ask's hold-to-talk, QuickAsk.swift: recognised on this iPhone only, requiresOnDeviceRecognition) -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>To turn what you say into text, on this iPhone, while you hold the microphone in TRIF.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>To save pictures from websites to your photos.</string>
	<!-- (the phone link, PhoneLinkPair.swift: finding TRIF on the user's computer over Bonjour, `_trif._tcp`, and
	     connecting to it; docs/PHONE-LINK.md section 5 on branch phone-link) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>TRIF looks for your computer on your Wi-Fi when you choose My computer.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_trif._tcp</string>
	</array>
	<!-- (sound and video go on with the app in the background or the phone locked: Browser.swift
	     BackgroundPlay. Tim, 11-16: YouTube with his Background Play mod) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- (the launch screen: black with TRIF's robot in the middle, the same as LeavingCover.swift's cover, so a cold
	     launch from a Home Screen icon and a return to the app look alike; black in light and dark mode, after the
	     Web Clip's own black screen. Tim, 11-18. iOS keeps a launch screen until the app is reinstalled or the phone
	     restarts. INFOPLIST_KEY_UILaunchScreen_Generation is NO, so this one is used) -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBlack</string>
		<key>UIImageName</key>
		<string>CoverRobot</string>
	</dict>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
