<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What Xcode's generated Info.plist can't say (GENERATE_INFOPLIST_FILE merges this in): the files the app opens
     from the share sheet, AirDrop and Files (Import.swift): a mod (.js), a zip of mods or a browser's export, a
     history export (.json). Copies come to the app (not opened in place), which reads and then removes them. -->
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>TRIF mod</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.netscape.javascript-source</string>
				<string>public.zip-archive</string>
				<string>public.json</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.timsrobot.trifprobe.pause</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Pause all mods</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypePause</string>
		</dict>
	</array>
	<!-- (a page asking for the camera or microphone, x.com's compose for a photo: without these iOS ends the app at
	     once. Tim's phone, 11-15 23:08, a TCC abort) -->
	<key>NSCameraUsageDescription</key>
	<string>Websites you visit can ask to use the camera, for a photo or a video call.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Websites you visit can ask to use the microphone, for a voice or video call.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>To save pictures from websites to your photos.</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
